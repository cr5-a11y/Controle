<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mundo Pet - O melhor para o seu companheiro</title>
    
<script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandBlue: '#1E3A8A',
                        brandLightBlue: '#3B82F6',
                        brandOrange: '#F97316',
                        brandYellow: '#FBBF24',
                        brandBG: '#F8FAFC'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-brandBG text-slate-800 font-sans antialiased">

    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brandOrange to-brandYellow flex items-center justify-center text-white text-2xl shadow-lg shadow-orange-500/30 group-hover:scale-105 transition-transform">
                    <i class="fa-solid font-black fa-paw"></i>
                </div>
                <div>
                    <span class="text-2xl font-black text-brandBlue tracking-tight">Mundo<span class="text-brandOrange">Pet</span></span>
                    <span class="block text-xs font-semibold text-slate-400 -mt-1">Amor & Cuidados</span>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8 font-semibold text-slate-600">
                <a href="#inicio" class="hover:text-brandOrange transition-colors">Início</a>
                <a href="#servicos" class="hover:text-brandOrange transition-colors">Serviços</a>
                <a href="#galeria" class="hover:text-brandOrange transition-colors">Galeria</a>
                <a href="#agendamento" class="px-5 py-2.5 rounded-full bg-brandOrange text-white font-bold hover:bg-orange-600 shadow-md shadow-orange-500/20 transition-all hover:scale-105">Agendar Visita</a>
            </nav>

            <button id="menuBtn" class="md:hidden text-2xl text-brandBlue focus:outline-none">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <div id="mobileMenu" class="hidden md:hidden bg-white border-b border-slate-100 px-6 py-4 flex-col gap-4 font-semibold text-slate-600">
            <a href="#inicio" class="py-2 hover:text-brandOrange">Início</a>
            <a href="#servicos" class="py-2 hover:text-brandOrange">Serviços</a>
            <a href="#galeria" class="py-2 hover:text-brandOrange">Galeria</a>
            <a href="#agendamento" class="py-2 text-brandOrange font-bold">Agendar Visita</a>
        </div>
    </header>

    <section id="inicio" class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-blue-50/50 to-transparent">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6 text-center md:text-left">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-100 text-brandOrange font-bold text-sm">
                    <i class="fa-solid fa-heart"></i> O melhor pet shop da região
                </div>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brandBlue leading-tight">
                    Cuidado, carinho e <span class="text-brandOrange underline decoration-brandYellow decoration-wavy">alegria</span> para o seu pet.
                </h1>
                <p class="text-lg text-slate-600 max-w-xl mx-auto md:mx-0">
                    Oferecemos serviços completos de saúde, estética e bem-estar para cães, gatos e outros bichinhos com equipe especializada e muito amor.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start pt-2">
                    <a href="#agendamento" class="px-8 py-4 rounded-full bg-brandOrange text-white font-bold text-lg hover:bg-orange-600 shadow-lg shadow-orange-500/30 transition-all hover:-translate-y-1 text-center">
                        Agendar Horário
                    </a>
                    <a href="#servicos" class="px-8 py-4 rounded-full bg-white text-brandBlue border-2 border-brandBlue/20 font-bold text-lg hover:border-brandBlue shadow-sm transition-all text-center">
                        Conhecer Serviços
                    </a>
                </div>
            </div>

            <div class="relative">
                <div class="absolute -top-6 -left-6 w-72 h-72 bg-brandYellow/30 rounded-full blur-3xl -z-10"></div>
                <div class="absolute -bottom-6 -right-6 w-72 h-72 bg-brandLightBlue/20 rounded-full blur-3xl -z-10"></div>
                <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
                    <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1000&q=80" alt="Cães felizes correndo" class="w-full h-[400px] lg:h-[480px] object-cover hover:scale-105 transition-transform duration-500" onerror="this.src='https://placehold.co/800x600/1E3A8A/FFFFFF?text=Mundo+Pet'">
                </div>
            </div>
        </div>
    </section>

    <section id="servicos" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-brandOrange font-bold tracking-wider uppercase text-sm">O Que Fazemos</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-brandBlue mt-2">Nossos Serviços Especializados</h2>
                <p class="text-slate-600 mt-4">Tudo o que seu companheiro precisa em um único lugar com atendimento VIP.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-brandBG p-8 rounded-3xl border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all group">
                    <div class="w-16 h-16 rounded-2xl bg-blue-100 text-brandLightBlue flex items-center justify-center text-3xl mb-6 group-hover:bg-brandLightBlue group-hover:text-white transition-colors">
                        <i class="fa-solid fa-soap"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-brandBlue mb-3">Banho & Tosa</h3>
                    <p class="text-slate-600 leading-relaxed mb-4">
                        Produtos hipoalergênicos, secagem com controle de temperatura e tosas higiênicas ou da raça.
                    </p>
                    <span class="text-brandOrange font-bold text-sm inline-flex items-center gap-2">A partir de R$ 50 <i class="fa-solid fa-arrow-right"></i></span>
                </div>

                <div class="bg-brandBG p-8 rounded-3xl border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all group">
                    <div class="w-16 h-16 rounded-2xl bg-orange-100 text-brandOrange flex items-center justify-center text-3xl mb-6 group-hover:bg-brandOrange group-hover:text-white transition-colors">
                        <i class="fa-solid fa-user-nurse"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-brandBlue mb-3">Consultas Veterinárias</h3>
                    <p class="text-slate-600 leading-relaxed mb-4">
                        Veterinários experientes para check-ups gerais, exames, vacinação e acompanhamento preventivo.
                    </p>
                    <span class="text-brandOrange font-bold text-sm inline-flex items-center gap-2">Atendimento Completo <i class="fa-solid fa-arrow-right"></i></span>
                </div>

                <div class="bg-brandBG p-8 rounded-3xl border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all group">
                    <div class="w-16 h-16 rounded-2xl bg-amber-100 text-brandYellow flex items-center justify-center text-3xl mb-6 group-hover:bg-brandYellow group-hover:text-white transition-colors">
                        <i class="fa-solid fa-bone"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-brandBlue mb-3">Adestramento</h3>
                    <p class="text-slate-600 leading-relaxed mb-4">
                        Técnicas modernas de reforço positivo para socialização, comandos básicos e correção de hábitos.
                    </p>
                    <span class="text-brandOrange font-bold text-sm inline-flex items-center gap-2">Aulas Individuais <i class="fa-solid fa-arrow-right"></i></span>
                </div>
            </div>
        </div>
    </section>

    <section id="galeria" class="py-20 bg-gradient-to-b from-transparent to-blue-50/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-brandOrange font-bold tracking-wider uppercase text-sm">Nossos Clientes</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-brandBlue mt-2">Galeria de Pets Fofos</h2>
                <p class="text-slate-600 mt-4">Confira alguns dos amiguinhos que passaram por aqui e saíram felizes!</p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="relative group overflow-hidden rounded-2xl shadow-lg h-72">
                    <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=600&q=80" alt="Cão golden retriever" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x600/3B82F6/FFFFFF?text=Pet+1'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                        <div class="text-white">
                            <h4 class="font-bold text-lg">Thor</h4>
                            <p class="text-xs text-amber-300">Golden Retriever</p>
                        </div>
                    </div>
                </div>

                <div class="relative group overflow-hidden rounded-2xl shadow-lg h-72">
                    <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=600&q=80" alt="Gato fofo" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x600/F97316/FFFFFF?text=Pet+2'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                        <div class="text-white">
                            <h4 class="font-bold text-lg">Mimi</h4>
                            <p class="text-xs text-amber-300">Gato Siamês</p>
                        </div>
                    </div>
                </div>

                <div class="relative group overflow-hidden rounded-2xl shadow-lg h-72">
                    <img src="https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?auto=format&fit=crop&w=600&q=80" alt="Cão pequeno" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x600/1E3A8A/FFFFFF?text=Pet+3'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                        <div class="text-white">
                            <h4 class="font-bold text-lg">Bob</h4>
                            <p class="text-xs text-amber-300">Pug</p>
                        </div>
                    </div>
                </div>

                <div class="relative group overflow-hidden rounded-2xl shadow-lg h-72">
                    <img src="https://images.unsplash.com/photo-1425082661705-1834bfd09dca?auto=format&fit=crop&w=600&q=80" alt="Hamster fofo" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x600/FBBF24/FFFFFF?text=Pet+4'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                        <div class="text-white">
                            <h4 class="font-bold text-lg">Pipoca</h4>
                            <p class="text-xs text-amber-300">Hamster</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="agendamento" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-gradient-to-br from-brandBlue to-blue-900 rounded-3xl p-8 sm:p-12 shadow-2xl text-white relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-brandOrange/20 rounded-full blur-2xl"></div>

                <div class="text-center max-w-xl mx-auto mb-10 relative z-10">
                    <h2 class="text-3xl font-extrabold text-white">Agende o Atendimento</h2>
                    <p class="text-blue-100 mt-2">Preencha o formulário abaixo e entraremos em contato rapidamente para confirmar a data do seu pet.</p>
                </div>

                <div id="alertBox" class="hidden mb-6 p-4 rounded-xl bg-emerald-500 text-white font-medium text-center relative z-10">
                    Agendamento enviado com sucesso! Entraremos em contato em breve.
                </div>

                <form id="petForm" class="space-y-6 relative z-10">
                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold mb-2 text-blue-100">Nome do Tutor</label>
                            <input type="text" id="tutorName" required placeholder="Seu nome completo" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-blue-200/60 focus:outline-none focus:ring-2 focus:ring-brandOrange">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2 text-blue-100">Telefone / WhatsApp</label>
                            <input type="tel" id="tutorPhone" required placeholder="(00) 00000-0000" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-blue-200/60 focus:outline-none focus:ring-2 focus:ring-brandOrange">
                        </div>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold mb-2 text-blue-100">E-mail</label>
                            <input type="email" id="tutorEmail" required placeholder="seu@email.com" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-blue-200/60 focus:outline-none focus:ring-2 focus:ring-brandOrange">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2 text-blue-100">Nome do Pet</label>
                            <input type="text" id="petName" required placeholder="Ex: Rex, Mel..." class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-blue-200/60 focus:outline-none focus:ring-2 focus:ring-brandOrange">
                        </div>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold mb-2 text-blue-100">Tipo de Pet</label>
                            <select id="petType" required class="w-full px-4 py-3 rounded-xl bg-brandBlue border border-white/20 text-white focus:outline-none focus:ring-2 focus:ring-brandOrange">
                                <option value="" disabled selected>Selecione uma opção</option>
                                <option value="cao">Cão</option>
                                <option value="gato">Gato</option>
                                <option value="outro">Outro (Aves, Roedores, etc)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2 text-blue-100">Serviço Desejado</label>
                            <select id="petService" required class="w-full px-4 py-3 rounded-xl bg-brandBlue border border-white/20 text-white focus:outline-none focus:ring-2 focus:ring-brandOrange">
                                <option value="" disabled selected>Selecione o serviço</option>
                                <option value="banho-tosa">Banho & Tosa</option>
                                <option value="consulta">Consulta Veterinária</option>
                                <option value="adestramento">Adestramento</option>
                                <option value="vacina">Vacinação</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold mb-2 text-blue-100">Mensagem ou Observações</label>
                        <textarea id="petMessage" rows="4" placeholder="Conte-nos sobre preferências, porte ou necessidades especiais do pet..." class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-blue-200/60 focus:outline-none focus:ring-2 focus:ring-brandOrange"></textarea>
                    </div>

                    <button type="submit" class="w-full py-4 rounded-xl bg-brandOrange text-white font-black text-lg hover:bg-orange-600 shadow-xl shadow-orange-500/30 transition-all hover:scale-[1.01]">
                        Confirmar Agendamento
                    </button>
                </form>
            </div>
        </div>
    </section>

    <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-8 mb-8">
            <div>
                <a href="#" class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-brandOrange flex items-center justify-center text-white text-xl">
                        <i class="fa-solid fa-paw"></i>
                    </div>
                    <span class="text-xl font-black text-white tracking-tight">Mundo<span class="text-brandOrange">Pet</span></span>
                </a>
                <p class="text-sm text-slate-400">Dedicação total ao bem-estar do seu animal de estimação. Qualidade, higiene e muito carinho.</p>
            </div>

            <div>
                <h4 class="text-white font-bold mb-4">Horário de Funcionamento</h4>
                <p class="text-sm">Segunda a Sexta: 08h às 19h</p>
                <p class="text-sm">Sábado: 08h às 16h</p>
                <p class="text-sm">Domingo: Fechado</p>
            </div>

            <div>
                <h4 class="text-white font-bold mb-4">Redes Sociais</h4>
                <div class="flex gap-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-white hover:bg-brandOrange transition-colors"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-white hover:bg-brandOrange transition-colors"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-white hover:bg-brandOrange transition-colors"><i class="fa-brands fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 border-t border-slate-800 text-center text-xs text-slate-500">
            &copy; 2026 Mundo Pet. Todos os direitos reservados.
        </div>
    </footer>

    <script>
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const petForm = document.getElementById('petForm');
        const alertBox = document.getElementById('alertBox');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            mobileMenu.classList.toggle('flex');
        });

        petForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alertBox.classList.remove('hidden');
            petForm.reset();
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 5000);
        });
    </script>
</body>
</html>
